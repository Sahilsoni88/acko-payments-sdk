SERVER_PORT=8080
PAYMENT_CONNECT_TIMEOUT=2s
PAYMENT_READ_TIMEOUT=10s
PAYMENT_RETRY_ENABLED=true
PAYMENT_RETRY_MAX_ATTEMPTS=3
PAYMENT_RETRY_BACKOFF=500ms

PAYMENT_PAYOUT_BASE_URL=https://payout-service-uat.internal.ackodev.com

# Use the real cookie header expected by payout-service.
# Example: user_id=... or internalPayoutCookie=...
PAYMENT_PAYOUT_COOKIE_HEADER=user_id=replace_me
